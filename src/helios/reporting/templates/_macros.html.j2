{# Shared report macros — imported by profile templates with context. #}

{% macro metric_card(value, label, panel, section, go_text, value_class='') -%}
<a class="metric" href="#{{ section }}" data-panel="{{ panel }}" data-section="{{ section }}">
    <div class="value {{ value_class }}">{{ value }}</div>
    <div class="label">{{ label }}</div>
    <div class="go">{{ go_text }} →</div>
</a>
{%- endmacro %}

{% macro events_table(rows, id=None, max_rows=500) -%}
<table class="report-table"{% if id %} id="{{ id }}"{% endif %}>
    <thead>
        <tr>
            <th class="size-nowrap">Timestamp</th>
            <th>Event Type</th>
            <th>Source</th>
            <th>Path / Details</th>
            <th class="size-nowrap">Confidence</th>
        </tr>
    </thead>
    <tbody>
        {% for r in rows[:max_rows] %}
        <tr>
            <td class="size-nowrap">{{ r.timestamp }}</td>
            <td><span class="badge badge-blue">{{ r.type }}</span></td>
            <td>{{ r.source }}</td>
            <td>
                {% if r.path %}<code>{{ r.path }}</code>{% else %}—{% endif %}
                {% if r.destination %}<br><small style="color: var(--muted);">→ {{ r.destination }}</small>{% endif %}
            </td>
            <td class="size-nowrap">{{ r.confidence }}</td>
        </tr>
        {% else %}
        <tr><td colspan="5" class="empty-state">No events recorded.</td></tr>
        {% endfor %}
    </tbody>
</table>
{% if rows | length > max_rows %}<p class="empty-state">Showing first {{ max_rows }} of {{ rows | length }} events — the full list is in the exported CSV.</p>{% endif %}
{%- endmacro %}

{% macro key_findings_card() -%}
<div class="card">
    <h3>Key Findings</h3>
    {% if top_alerts %}
    <ul class="findings">
        {% for alert in top_alerts %}
        {% set sev = alert.severity.value if alert.severity is defined and alert.severity is not none and alert.severity.value is defined else alert.severity %}
        <li>
            <span class="sev-badge sev-{{ sev | lower }}">{{ sev | upper }}</span>
            <span style="min-width: 0;">
                <strong>{{ alert.title }}</strong> — {{ alert.description }}
                {% if alert.evidence %}
                <br><small style="color: var(--muted);">
                    {% set paths = [] %}
                    {% for e in alert.evidence %}
                        {% if e is string and ('\\' in e or '/' in e) %}{% if paths.append(e) %}{% endif %}{% endif %}
                    {% endfor %}
                    {% if paths %}Artifact: <code>{{ paths[0] }}</code>{% else %}Artifact: <code>{{ alert.evidence | join('; ') }}</code>{% endif %}
                </small>
                {% endif %}
            </span>
        </li>
        {% endfor %}
    </ul>
    {% else %}
    <p class="empty-state">No alerts raised during this investigation.</p>
    {% endif %}
</div>
{%- endmacro %}

{% macro devices_card() -%}
<div class="card" id="sec-devices">
    <h3>Scanned Devices &amp; Volumes</h3>
    {% if drives %}
    <table class="report-table dev-table">
        <thead>
            <tr>
                <th>Volume</th>
                <th>Label</th>
                <th>Filesystem</th>
                <th class="size-nowrap">Total Size</th>
                <th class="size-nowrap">Free Space</th>
                <th>Type</th>
            </tr>
        </thead>
        <tbody>
            {% for drv in drives %}
            <tr>
                <td><strong>{{ drv.drive_letter }}</strong></td>
                <td>{{ drv.label or 'System Volume' }}</td>
                <td><code>{{ drv.filesystem or 'NTFS' }}</code></td>
                <td>{{ (drv.total_size / (1024**3)) | round(2) }} GB</td>
                <td>{{ (drv.free_space / (1024**3)) | round(2) }} GB</td>
                <td>
                    {% if drv.is_removable %}
                    <span class="badge badge-warn">USB Removable</span>
                    {% else %}
                    <span class="badge badge-ok">Fixed</span>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <p class="empty-state">No volume data recorded.</p>
    {% endif %}
</div>
{%- endmacro %}

{% macro module_exec_card() -%}
<div class="card">
    <h3>Investigation Profile &amp; Module Execution</h3>
    <p class="section-desc">
        Profile: <strong>{{ investigation.profile_name or 'full' | upper }}</strong>
        {% if investigation.profile_name %}
            — the modules below reflect what the selected profile actually ran during this scan.
        {% endif %}
    </p>
    {% if investigation.module_results %}
    <table class="report-table">
        <thead>
            <tr>
                <th>Module</th>
                <th>Status</th>
                <th>Events</th>
                <th>Alerts</th>
                <th>Files</th>
                <th>Detail</th>
            </tr>
        </thead>
        <tbody>
            {% for m in investigation.module_results %}
            <tr>
                <td><strong>{{ m.label }}</strong></td>
                <td>
                    {% if m.status == 'ran' %}
                    <span class="badge badge-ok">Ran</span>
                    {% elif m.status == 'failed' %}
                    <span class="badge badge-danger">Failed</span>
                    {% else %}
                    <span class="badge badge-warn">Disabled / Skipped</span>
                    {% endif %}
                </td>
                <td>{{ m.events }}</td>
                <td>{{ m.alerts }}</td>
                <td>{{ m.files | default(0) }}</td>
                <td style="color: var(--muted);">
                    {% if m.status == 'failed' %}<code>{{ m.detail }}</code>
                    {% else %}{{ m.detail or '—' }}{% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <p class="empty-state">No module execution log recorded for this investigation.</p>
    {% endif %}
</div>
{%- endmacro %}

{% macro alerts_panel_card() -%}
<div class="card" id="sec-alerts">
    {% if investigation.alerts %}
    {{ alerts_table_html | safe }}
    {% else %}
    <p class="empty-state">No alerts raised during this investigation.</p>
    {% endif %}
</div>
{%- endmacro %}

{% macro evidence_panel_card() -%}
<div class="card">
    <h3>Case Identification</h3>
    <table class="report-table">
        <tbody>
            <tr><td style="width: 200px;">Case Reference</td><td><strong>{{ investigation.case_name }}</strong> (<code>{{ investigation.case_id }}</code>)</td></tr>
            <tr><td>Lead Investigator</td><td>{{ investigation.investigator or 'Ahmad Forensics' }}</td></tr>
            <tr><td>Report Generated</td><td>{{ generated_at }}</td></tr>
            <tr><td>Scanned Targets</td><td>{% for d in drives %}{{ d.drive_letter }} ({{ d.label or 'Volume' }}, {{ d.filesystem }}){% if not loop.last %}; {% endif %}{% else %}—{% endfor %}</td></tr>
        </tbody>
    </table>
</div>
<div class="card">
    <h3>Chain of Custody Audit Log</h3>
    {% if investigation.chain_of_custody %}
    <div class="custody-log">
        {% for entry in investigation.chain_of_custody %}
        <div>[{{ entry.timestamp }}] <strong>{{ entry.action }}</strong> — Target: {{ entry.target }} | Result: {{ entry.result }} (Tool: {{ entry.tool_name }})</div>
        {% endfor %}
    </div>
    {% else %}
    <p class="empty-state">[{{ generated_at }}] Case initialized by {{ investigation.investigator or 'Ahmad Forensics' }}. No additional custody entries recorded.</p>
    {% endif %}
</div>
<div class="card">
    <h3>Evidence Package</h3>
    <p style="font-size: 13px; color: var(--muted);">
        The full dataset (events, alerts, file records, correlations) is exported alongside this report
        as JSON and CSV, and packaged into a tamper-evident ZIP with SHA-256 integrity verification
        (see <code>exports/</code> and the chain-of-custody JSON in the case output directory).
    </p>
</div>
{%- endmacro %}
