{% extends "_base.html.j2" %}
{% from "_macros.html.j2" import metric_card, events_table, key_findings_card, devices_card, module_exec_card, alerts_panel_card, evidence_panel_card with context %}

{% block report_title %}Helios Employee Exit Report — {{ investigation.case_name }}{% endblock %}

{% block profile_label %}Employee Exit Review{% endblock %}
{% block brand_sub %}USB activity, recent file access, folder history & deletions{% endblock %}

{% block tabs_html %}
<button class="tab active" data-panel="tab-summary">Summary</button>
<button class="tab" data-panel="tab-movement">Data Movement</button>
<button class="tab" data-panel="tab-events">Events</button>
<button class="tab" data-panel="tab-alerts">Alerts</button>
<button class="tab" data-panel="tab-evidence">Evidence</button>
{% endblock %}

{% block panels_html %}

<!-- ================= SUMMARY ================= -->
<div id="tab-summary" class="panel active">
    <h2 class="section-title">Exit Review Summary</h2>
    <p class="section-desc">Insider-threat focus: USB activity, recently accessed files, folder navigation and deletions around the departure window.</p>

    <div class="metric-row">
        {{ metric_card(investigation.events | length, "Forensic Events", "tab-events", "sec-events", "View event log") }}
        {{ metric_card(movements | length, "File Transfers", "tab-movement", "sec-transfers", "View transfers") }}
        {{ metric_card(deletions | length, "Deleted Files", "tab-movement", "sec-deletions", "View deletions", "danger") }}
        {{ metric_card(investigation.alerts | length, "Alerts Raised", "tab-alerts", "sec-alerts", "View alerts", "warn") }}
        {{ metric_card(investigation.file_records | length, "Files Indexed", "tab-summary", "sec-devices", "View scanned devices") }}
    </div>

    <div class="chart-grid {% if not sections.deletion_chart %}single{% endif %}">
        <div class="card">
            <h3>File Types Distribution</h3>
            <div id="filetypeChart"></div>
        </div>
        {% if sections.deletion_chart %}
        <div class="card">
            <h3>Deletions by Day</h3>
            <div id="deletionChart"></div>
        </div>
        {% endif %}
    </div>

    <div class="card">
        <h3>Recently Accessed Files (LNK / JumpLists)</h3>
        <p class="section-desc">User-opened documents and files tracked through Windows Shortcut (.lnk) and JumpList artifacts.</p>
        {% if access_rows %}
        <table class="report-table">
            <thead>
                <tr>
                    <th class="size-nowrap">Timestamp</th>
                    <th>File Path</th>
                    <th>Source</th>
                    <th class="size-nowrap">Confidence</th>
                </tr>
            </thead>
            <tbody>
                {% for r in access_rows[:200] %}
                <tr>
                    <td class="size-nowrap">{{ r.timestamp }}</td>
                    <td><code>{{ r.path or '-' }}</code></td>
                    <td>{{ r.source }}</td>
                    <td class="size-nowrap">{{ r.confidence }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% if access_rows | length > 200 %}<p class="empty-state">Showing first 200 of {{ access_rows | length }} access entries.</p>{% endif %}
        {% else %}
        <p class="empty-state">No LNK/JumpList access entries found during this investigation.</p>
        {% endif %}
    </div>

    <div class="card">
        <h3>Folder Browsing History (ShellBags)</h3>
        <p class="section-desc">Directories and external folders browsed by the user in Windows Explorer.</p>
        {% if shellbags_rows %}
        <table class="report-table">
            <thead>
                <tr>
                    <th class="size-nowrap">Timestamp</th>
                    <th>Folder Path</th>
                    <th>Source</th>
                </tr>
            </thead>
            <tbody>
                {% for r in shellbags_rows[:200] %}
                <tr>
                    <td class="size-nowrap">{{ r.timestamp }}</td>
                    <td><code>{{ r.path or '-' }}</code></td>
                    <td>{{ r.raw_source }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% if shellbags_rows | length > 200 %}<p class="empty-state">Showing first 200 of {{ shellbags_rows | length }} folder browsing entries.</p>{% endif %}
        {% else %}
        <p class="empty-state">No ShellBags folder browsing history detected.</p>
        {% endif %}
    </div>

    <div class="card">
        <h3>Recovered Deleted Files (SleuthKit / MFT)</h3>
        <p class="section-desc">Files recovered from unallocated space — deleted data identified on the storage media.</p>
        {% if deleted_files %}
        <table class="report-table">
            <thead>
                <tr>
                    <th>File Name</th>
                    <th>Path</th>
                    <th class="size-nowrap">Size</th>
                    <th class="size-nowrap">Modified</th>
                    <th>Recovery Status</th>
                </tr>
            </thead>
            <tbody>
                {% for f in deleted_files[:300] %}
                <tr>
                    <td><strong>{{ f.file_name }}</strong></td>
                    <td><code>{{ f.file_path }}</code></td>
                    <td class="size-nowrap">{{ f.size }} bytes</td>
                    <td class="size-nowrap">{{ f.modified }}</td>
                    <td>
                        {% if f.recovery_status == 'RECOVERABLE' %}
                        <span class="badge badge-ok">Recoverable</span>
                        {% elif f.recovery_status == 'PARTIAL' %}
                        <span class="badge badge-warn">Partial</span>
                        {% else %}
                        <span class="badge badge-blue">{{ f.recovery_status }}</span>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% if deleted_files | length > 300 %}<p class="empty-state">Showing first 300 of {{ deleted_files | length }} recovered files.</p>{% endif %}
        {% else %}
        <p class="empty-state">No deleted files recovered. SleuthKit requires administrator privileges and raw-disk access.</p>
        {% endif %}
    </div>

    {{ key_findings_card() }}
    {{ devices_card() }}
    {{ module_exec_card() }}
</div>

<!-- ================= DATA MOVEMENT ================= -->
<div id="tab-movement" class="panel">
    <h2 class="section-title">Data Movement &amp; Transfers</h2>
    <p class="section-desc">Files transferred to external devices and files deleted during the departure timeframe.</p>

    <div class="card" id="sec-transfers">
        <h3>File Transfers</h3>
        {% if movements %}
        <table class="report-table">
            <thead>
                <tr>
                    <th>File</th>
                    <th>SHA-256</th>
                    <th>Source</th>
                    <th>Destination</th>
                    <th class="size-nowrap">When</th>
                </tr>
            </thead>
            <tbody>
                {% for m in movements %}
                <tr>
                    <td>
                        <strong>{{ m.file_name }}</strong>
                        {% if m.source_path %}<br><small style="color: var(--muted);">{{ m.source_path }}</small>{% endif %}
                    </td>
                    <td><code>{{ m.hash or '-' }}</code></td>
                    <td>{{ m.source }}</td>
                    <td>{{ m.target }}</td>
                    <td class="size-nowrap">{{ m.timestamp }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p class="empty-state">No cross-device file transfers detected.</p>
        {% endif %}
    </div>

    <div class="card" id="sec-deletions">
        <h3>Deleted Files</h3>
        {% if deletions %}
        <table class="report-table">
            <thead>
                <tr>
                    <th>File</th>
                    <th>Source</th>
                    <th class="size-nowrap">When</th>
                </tr>
            </thead>
            <tbody>
                {% for d in deletions %}
                <tr>
                    <td><strong>{{ d.file_name }}</strong></td>
                    <td>{{ d.source }}</td>
                    <td class="size-nowrap">{{ d.timestamp }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p class="empty-state">No deletions detected.</p>
        {% endif %}
    </div>
</div>

<!-- ================= EVENTS ================= -->
<div id="tab-events" class="panel">
    <h2 class="section-title">Departure Event Log</h2>
    <p class="section-desc">File access, USB connections, and file handling events collected during the departure review.</p>
    <div class="card" id="sec-events">
        {% set exit_events = [] %}
        {% for r in timeline_rows if r.type in ('USB_CONNECT', 'USB_DISCONNECT', 'FILE_COPY', 'FILE_MOVE', 'FILE_DELETE', 'FILE_MODIFY', 'FILE_CREATE', 'FILE_ACCESS', 'DEVICE_CONNECT') %}
            {% if exit_events.append(r) %}{% endif %}
        {% endfor %}
        {{ events_table(exit_events) }}
    </div>
</div>

<!-- ================= ALERTS ================= -->
<div id="tab-alerts" class="panel">
    <h2 class="section-title">Security Alerts</h2>
    <p class="section-desc">Insider-threat and policy violation indicators detected by the analysis engine.</p>
    {{ alerts_panel_card() }}
</div>

<!-- ================= EVIDENCE ================= -->
<div id="tab-evidence" class="panel">
    <h2 class="section-title">Evidence &amp; Chain of Custody</h2>
    <p class="section-desc">Case identification and the audit log of every tool action taken.</p>
    {{ evidence_panel_card() }}
</div>

{% endblock %}

{% block charts_js %}
['#filetypeChart', {{ filetype_chart_json | safe }}],
{% if sections.deletion_chart %}['#deletionChart', {{ deletion_chart_json | safe }}],{% endif %}
{% endblock %}
