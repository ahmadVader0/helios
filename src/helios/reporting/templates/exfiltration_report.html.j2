{% extends "_base.html.j2" %}
{% from "_macros.html.j2" import metric_card, events_table, key_findings_card, devices_card, module_exec_card, alerts_panel_card, evidence_panel_card with context %}

{% block report_title %}Helios Exfiltration Report — {{ investigation.case_name }}{% endblock %}

{% block profile_label %}Exfiltration Investigation{% endblock %}
{% block brand_sub %}USB transfers, cross-device data movement, staging & exfiltration detection{% endblock %}

{% block tabs_html %}
<button class="tab active" data-panel="tab-summary">Summary</button>
<button class="tab" data-panel="tab-movement">Data Movement</button>
<button class="tab" data-panel="tab-events">Events</button>
<button class="tab" data-panel="tab-alerts">Alerts</button>
<button class="tab" data-panel="tab-evidence">Evidence</button>
{% endblock %}

{% block panels_html %}

<!-- ================= SUMMARY ================= -->
<div id="tab-summary" class="panel active">
    <h2 class="section-title">Exfiltration Summary</h2>
    <p class="section-desc">Data exfiltration focus: what moved off the device, what was deleted after copy, and what raised alarms.</p>

    <div class="metric-row">
        {{ metric_card(movements | length, "File Transfers", "tab-movement", "sec-transfers", "View transfers") }}
        {{ metric_card(deletions | length, "Post-Transfer Deletions", "tab-movement", "sec-deletions", "View deletions", "danger") }}
        {{ metric_card(investigation.events | length, "Forensic Events", "tab-events", "sec-events", "View event log") }}
        {{ metric_card(investigation.alerts | length, "Alerts Raised", "tab-alerts", "sec-alerts", "View alerts", "warn") }}
        {{ metric_card(investigation.file_records | length, "Files Indexed", "tab-summary", "sec-devices", "View scanned devices") }}
    </div>

    {% if sections.transfers %}
    <div class="chart-grid single">
        <div class="card">
            <h3>Data Flow Between Devices</h3>
            <div id="dataFlowChart"></div>
        </div>
    </div>
    {% endif %}

    {% if sections.usb_transfers %}
    <div class="card">
        <h3>USB Connection Timeline</h3>
        <p class="section-desc">USB device connections and mass storage mounting history from Registry and SetupAPI logs.</p>
        {% if usb_rows %}
        <table class="report-table">
            <thead>
                <tr>
                    <th class="size-nowrap">Timestamp</th>
                    <th>Event</th>
                    <th>Path / Details</th>
                    <th>Source</th>
                </tr>
            </thead>
            <tbody>
                {% for r in usb_rows[:200] %}
                <tr>
                    <td class="size-nowrap">{{ r.timestamp }}</td>
                    <td><span class="badge badge-warn">{{ r.type }}</span></td>
                    <td>{% if r.path %}<code>{{ r.path }}</code>{% else %}-{% endif %}</td>
                    <td>{{ r.raw_source }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% if usb_rows | length > 200 %}<p class="empty-state">Showing first 200 of {{ usb_rows | length }} USB events.</p>{% endif %}
        {% else %}
        <p class="empty-state">No USB connection events detected on the target system.</p>
        {% endif %}
    </div>
    {% endif %}

    {{ key_findings_card() }}
    {{ devices_card() }}
    {{ module_exec_card() }}
</div>

<!-- ================= DATA MOVEMENT ================= -->
<div id="tab-movement" class="panel">
    <h2 class="section-title">Data Movement &amp; Exfiltration</h2>
    <p class="section-desc">Files transferred between devices and files deleted during or following transfer sessions.</p>

    <div class="card" id="sec-transfers">
        <h3>File Transfers (Cross-Device Match)</h3>
        {% if movements %}
        <table class="report-table">
            <thead>
                <tr>
                    <th>File</th>
                    <th>SHA-256</th>
                    <th>Source</th>
                    <th>Destination</th>
                    <th class="size-nowrap">When</th>
                </tr>
            </thead>
            <tbody>
                {% for m in movements %}
                <tr>
                    <td>
                        <strong>{{ m.file_name }}</strong>
                        {% if m.source_path %}<br><small style="color: var(--muted);">{{ m.source_path }}</small>{% endif %}
                    </td>
                    <td><code>{{ m.hash or '-' }}</code></td>
                    <td>{{ m.source }}</td>
                    <td>{{ m.target }}</td>
                    <td class="size-nowrap">{{ m.timestamp }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p class="empty-state">No cross-device file transfers detected. Transfers are reported when matching SHA-256 file hashes appear across different attached volumes.</p>
        {% endif %}
    </div>

    <div class="card" id="sec-deletions">
        <h3>Exfiltration Deletions</h3>
        {% if deletions %}
        <table class="report-table">
            <thead>
                <tr>
                    <th>File</th>
                    <th>Source</th>
                    <th class="size-nowrap">When</th>
                </tr>
            </thead>
            <tbody>
                {% for d in deletions %}
                <tr>
                    <td><strong>{{ d.file_name }}</strong></td>
                    <td>{{ d.source }}</td>
                    <td class="size-nowrap">{{ d.timestamp }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p class="empty-state">No post-transfer deletion patterns detected.</p>
        {% endif %}
    </div>
</div>

<!-- ================= EVENTS ================= -->
<div id="tab-events" class="panel">
    <h2 class="section-title">Exfiltration Event Log</h2>
    <p class="section-desc">USB connections, file copies, moves, and deletions relevant to exfiltration analysis.</p>
    <div class="card" id="sec-events">
        {% set exfil_events = [] %}
        {% for r in timeline_rows if r.type in ('USB_CONNECT', 'USB_DISCONNECT', 'DEVICE_CONNECT', 'FILE_COPY', 'FILE_MOVE', 'FILE_DELETE') %}
            {% if exfil_events.append(r) %}{% endif %}
        {% endfor %}
        {{ events_table(exfil_events) }}
    </div>
</div>

<!-- ================= ALERTS ================= -->
<div id="tab-alerts" class="panel">
    <h2 class="section-title">Security Alerts</h2>
    <p class="section-desc">Exfiltration and staging anomalies detected by the analysis engine.</p>
    {{ alerts_panel_card() }}
</div>

<!-- ================= EVIDENCE ================= -->
<div id="tab-evidence" class="panel">
    <h2 class="section-title">Evidence &amp; Chain of Custody</h2>
    <p class="section-desc">Case identification and the audit log of every tool action taken.</p>
    {{ evidence_panel_card() }}
</div>

{% endblock %}

{% block charts_js %}
{% if sections.transfers %}['#dataFlowChart', {{ data_flow_chart_json | safe }}],{% endif %}
{% endblock %}
