{% extends "_base.html.j2" %}
{% from "_macros.html.j2" import metric_card, key_findings_card, devices_card, module_exec_card, alerts_panel_card, evidence_panel_card, rules_appendix, events_explorer, usb_devices_card, prefetch_programs_card, logon_summary_card, shellbag_users_card with context %}

{% block report_title %}Helios Full Forensic Report — {{ investigation.case_name }}{% endblock %}

{% block profile_label %}Full System Forensics{% endblock %}
{% block brand_sub %}{% if profile_description %}{{ profile_description }}{% else %}All modules: transfers, deletions, access, execution, logs &amp; suspicious activity{% endif %}{% endblock %}

{% block tabs_html %}
<button class="tab active" data-panel="tab-summary">Summary</button>
{% if sections.data_movement %}<button class="tab" data-panel="tab-movement">Data Movement</button>{% endif %}
<button class="tab" data-panel="tab-timeline">Timeline &amp; Events</button>
<button class="tab" data-panel="tab-artifacts">System Artifacts</button>
<button class="tab" data-panel="tab-alerts">Alerts</button>
<button class="tab" data-panel="tab-evidence">Evidence</button>
{% endblock %}

{% block panels_html %}

<!-- ================= SUMMARY ================= -->
<div id="tab-summary" class="panel active">
    <h2 class="section-title">Executive Summary</h2>
    <p class="section-desc">
        {% if profile_description %}<strong>Scope:</strong> {{ profile_description }} —{% endif %}
        key figures from this investigation. Click any card to drill into its section.
    </p>

    <div class="metric-row">
        {{ metric_card(investigation.file_records | length, "Files Indexed", "tab-summary", "sec-devices", "View scanned devices") }}
        {{ metric_card(investigation.events | length, "Forensic Events", "tab-timeline", "sec-explorer", "Explore all events") }}
        {{ metric_card(investigation.alerts | length, "Alerts Raised", "tab-alerts", "sec-alerts", "View alerts", "warn") }}
        {% if sections.deletions %}
        {{ metric_card(deletions | length, "Deleted Files", "tab-movement", "sec-deletions", "View deletions", "danger") }}
        {% endif %}
        {% if sections.transfers %}
        {{ metric_card(movements | length, "File Transfers", "tab-movement", "sec-transfers", "View transfers") }}
        {% endif %}
    </div>

    <div class="chart-grid {% if not sections.deletion_chart %}single{% endif %}">
        <div class="card">
            <h3>File Types Distribution</h3>
            <div id="filetypeChart"></div>
        </div>
        {% if sections.deletion_chart %}
        <div class="card">
            <h3>Deletions by Day</h3>
            <div id="deletionChart"></div>
        </div>
        {% endif %}
    </div>

    {{ key_findings_card() }}
    {{ devices_card() }}
    {{ module_exec_card() }}

    {% if event_type_counts %}
    <div class="card">
        <h3>Collected Evidence by Event Type</h3>
        <p class="section-desc">Click a type to open it pre-filtered in the Event Explorer.</p>
        <div class="type-chips">
            {% for t, n in event_type_counts | dictsort(by='value') | reverse %}
            <button class="chip" data-evtype="{{ t }}">{{ t }}<span class="n">{{ n }}</span></button>
            {% endfor %}
        </div>
    </div>
    {% endif %}
</div>

<!-- ================= DATA MOVEMENT ================= -->
{% if sections.data_movement %}
<div id="tab-movement" class="panel">
    <h2 class="section-title">Data Movement</h2>
    <p class="section-desc">Files transferred between devices and files deleted during the investigation window.</p>

    {% if sections.transfers %}
    <div class="card">
        <h3>Data Flow Between Devices</h3>
        <div id="dataFlowChart"></div>
        {% if not movements and not deletions %}
        <p class="empty-state">No cross-device file movement was detected. This happens when the same file (by SHA-256 hash) is not found on more than one scanned device — e.g. no USB drive with matching files was attached during the scan.</p>
        {% endif %}
    </div>
    {% endif %}

    {% if sections.transfers %}
    <div class="card" id="sec-transfers">
        <h3>File Transfers</h3>
        {% if movements %}
        <table class="report-table">
            <thead>
                <tr>
                    <th>File</th>
                    <th>SHA-256</th>
                    <th>Source</th>
                    <th>Destination</th>
                    <th class="size-nowrap">When</th>
                </tr>
            </thead>
            <tbody>
                {% for m in movements %}
                <tr>
                    <td>
                        <strong>{{ m.file_name }}</strong>
                        {% if m.source_path %}<br><small style="color: var(--muted);">{{ m.source_path }}</small>{% endif %}
                    </td>
                    <td><code>{{ m.hash or '—' }}</code></td>
                    <td>{{ m.source }}</td>
                    <td>{{ m.target }}</td>
                    <td class="size-nowrap">{{ m.timestamp }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p class="empty-state">No file transfers detected. Transfers are reported when the same hash appears on two devices, or when LNK/USB artifacts prove a historic copy to removable media.</p>
        {% endif %}
    </div>
    {% endif %}

    {% if sections.deletions %}
    <div class="card" id="sec-deletions">
        <h3>Deleted Files &amp; Recovery</h3>
        {% if deletions %}
        <table class="report-table">
            <thead>
                <tr>
                    <th>File</th>
                    <th>Source Device / Path</th>
                    <th class="size-nowrap">Deleted / Modified</th>
                </tr>
            </thead>
            <tbody>
                {% for d in deletions %}
                <tr>
                    <td>
                        <strong>{{ d.file_name }}</strong>
                        {% if d.source_path %}<br><small style="color: var(--muted);">{{ d.source_path }}</small>{% endif %}
                    </td>
                    <td>{{ d.source }}</td>
                    <td class="size-nowrap">{{ d.timestamp }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% elif deleted_files %}
        <table class="report-table">
            <thead>
                <tr>
                    <th>File Name</th>
                    <th>Path</th>
                    <th class="size-nowrap">Size</th>
                    <th class="size-nowrap">Modified</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                {% for f in deleted_files[:300] %}
                <tr>
                    <td><strong>{{ f.file_name }}</strong></td>
                    <td><code>{{ f.file_path }}</code></td>
                    <td class="size-nowrap">{{ f.size }} bytes</td>
                    <td class="size-nowrap">{{ f.modified }}</td>
                    <td><span class="badge badge-ok">{{ f.recovery_status }}</span></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p class="empty-state">No deletions detected.</p>
        {% endif %}
        <div class="note-box">
            <strong>Limitation note:</strong> a file removed with <em>Shift+Delete</em> (or emptied from the
            Recycle Bin) bypasses the Recycle Bin entirely -- no <code>$I</code> metadata entry is ever created --
            so it is invisible to Recycle Bin parsing. Such deletions can only be recovered with raw-disk
            scanning (SleuthKit <code>fls</code>, requires administrator rights) or the NTFS USN journal.
        </div>
    </div>
    {% endif %}
</div>
{% endif %}

<!-- ================= TIMELINE & EVENTS ================= -->
<div id="tab-timeline" class="panel">
    <h2 class="section-title">Timeline &amp; Events</h2>
    <p class="section-desc">Event distribution over time, 24x7 activity pattern, and the fully searchable event index.</p>

    <div class="chart-grid">
        <div class="card" id="sec-timeline">
            <h3>Event Timeline</h3>
            <div id="timelineChart"></div>
        </div>
        <div class="card">
            <h3>24x7 Activity Heatmap</h3>
            <div id="heatmapChart"></div>
        </div>
    </div>

    {{ events_explorer() }}
</div>

<!-- ================= SYSTEM ARTIFACTS ================= -->
<div id="tab-artifacts" class="panel">
    <h2 class="section-title">System Artifacts</h2>
    <p class="section-desc">Parsed per-source views: program execution, known USB devices, account logons and folder browsing history.</p>

    {{ prefetch_programs_card() }}
    {{ usb_devices_card() }}
    {{ logon_summary_card() }}
    {{ shellbag_users_card() }}

    {% if not prefetch_programs and not usb_device_rows and not logon_summary and not shellbag_users %}
    <div class="card"><p class="empty-state">No system artifact tables were populated by this scan (see Module Execution on the Summary tab).</p></div>
    {% endif %}
</div>

<!-- ================= ALERTS ================= -->
<div id="tab-alerts" class="panel">
    <h2 class="section-title">Security Alerts</h2>
    <p class="section-desc">Anomalies and exfiltration indicators detected by the analysis engine.</p>
    {{ alerts_panel_card() }}
    {{ rules_appendix() }}
</div>

<!-- ================= EVIDENCE ================= -->
<div id="tab-evidence" class="panel">
    <h2 class="section-title">Evidence &amp; Chain of Custody</h2>
    <p class="section-desc">Case identification, audit log of every tool action, and downloadable exports.</p>
    {{ evidence_panel_card() }}
</div>

<script>
    /* Full event index for the client-side Event Explorer */
    window.HELIOS_EVENTS = {{ events_payload | tojson }};
</script>
<script type="application/json" id="helios-days">{{ activity_by_day | tojson }}</script>
{% endblock %}

{% block extra_js %}
/* Interactive activity-by-day bar: click a day to filter the explorer */
document.addEventListener('DOMContentLoaded', function () {
    const el = document.getElementById('explorerDayChart');
    if (!el) return;
    let days = [];
    try { days = JSON.parse(document.getElementById('helios-days').textContent); } catch (e) { return; }
    if (!days.length) return;
    const cats = days.map(d => d.date);
    new ApexCharts(el, {
        chart: {
            type: 'bar', height: 190, toolbar: { show: false },
            events: {
                dataPointSelection: (_e, _ctx, cfg) => {
                    const d = cats[cfg.dataPointIndex];
                    if (d) window.heliosFilterEvents({ from: d, to: d });
                }
            }
        },
        series: [{ name: 'events', data: days.map(d => d.count) }],
        xaxis: { categories: cats, labels: { show: false, rotate: 0 }, axisBorder: { show: false }, axisTicks: { show: false } },
        yaxis: { labels: { style: { fontSize: '11px' } } },
        dataLabels: { enabled: false },
        colors: ['#1d4ed8'],
        tooltip: { x: { show: true } },
        title: { text: 'Click a bar to filter that day', style: { fontSize: '12px', fontWeight: 400, color: '#6b7280' } }
    }).render();
});

function switchTabTo(panelId) {
    document.querySelectorAll('.tab').forEach(t => t.classList.toggle('active', t.dataset.panel === panelId));
    document.querySelectorAll('.panel').forEach(p => p.classList.toggle('active', p.id === panelId));
    setTimeout(() => window.dispatchEvent(new Event('resize')), 50);
}

/* Evidence-type chips -> jump to explorer pre-filtered (no inline JS from data) */
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.chip[data-evtype]').forEach(chip => {
        chip.addEventListener('click', function () {
            switchTabTo('tab-timeline');
            window.heliosFilterEvents({ type: chip.dataset.evtype });
        });
    });
});
{% endblock %}

{% block charts_js %}
['#filetypeChart', {{ filetype_chart_json | safe }}],
{% if sections.deletion_chart %}['#deletionChart', {{ deletion_chart_json | safe }}],{% endif %}
['#timelineChart', {{ timeline_chart_json | safe }}],
['#heatmapChart', {{ heatmap_chart_json | safe }}],
{% if sections.transfers %}['#dataFlowChart', {{ data_flow_chart_json | safe }}],{% endif %}
{% endblock %}
