{% extends "_base.html.j2" %}
{% from "_macros.html.j2" import metric_card, events_table, key_findings_card, devices_card, module_exec_card, alerts_panel_card, evidence_panel_card with context %}

{% block report_title %}Helios Full Forensic Report — {{ investigation.case_name }}{% endblock %}

{% block profile_label %}Full System Forensics{% endblock %}
{% block brand_sub %}All modules: transfers, deletions, access, execution, logs & suspicious activity{% endblock %}

{% block tabs_html %}
<button class="tab active" data-panel="tab-summary">Summary</button>
{% if sections.data_movement %}<button class="tab" data-panel="tab-movement">Data Movement</button>{% endif %}
<button class="tab" data-panel="tab-timeline">Timeline</button>
<button class="tab" data-panel="tab-alerts">Alerts</button>
<button class="tab" data-panel="tab-evidence">Evidence</button>
{% endblock %}

{% block panels_html %}

<!-- ================= SUMMARY ================= -->
<div id="tab-summary" class="panel active">
    <h2 class="section-title">Executive Summary</h2>
    <p class="section-desc">Scope and key findings of the full forensic investigation.</p>

    <div class="metric-row">
        {{ metric_card(investigation.file_records | length, "Files Indexed", "tab-summary", "sec-devices", "View scanned devices") }}
        {{ metric_card(investigation.events | length, "Forensic Events", "tab-timeline", "sec-timeline", "View timeline & events") }}
        {{ metric_card(investigation.alerts | length, "Alerts Raised", "tab-alerts", "sec-alerts", "View alerts", "warn") }}
        {% if sections.deletions %}
        {{ metric_card(deletions | length, "Deleted Files", "tab-movement", "sec-deletions", "View deletions", "danger") }}
        {% endif %}
        {% if sections.transfers %}
        {{ metric_card(movements | length, "File Transfers", "tab-movement", "sec-transfers", "View transfers") }}
        {% endif %}
    </div>

    <div class="chart-grid {% if not sections.deletion_chart %}single{% endif %}">
        <div class="card">
            <h3>File Types Distribution</h3>
            <div id="filetypeChart"></div>
        </div>
        {% if sections.deletion_chart %}
        <div class="card">
            <h3>Deletions by Day</h3>
            <div id="deletionChart"></div>
        </div>
        {% endif %}
    </div>

    <div class="card">
        <h3>Key Findings</h3>
        {% if top_alerts %}
        <ul class="findings">
            {% for alert in top_alerts %}
            {% set sev = alert.severity.value if alert.severity is defined and alert.severity is not none and alert.severity.value is defined else alert.severity %}
            <li>
                <span class="sev-badge sev-{{ sev | lower }}">{{ sev | upper }}</span>
                <span style="min-width: 0;">
                    <strong>{{ alert.title }}</strong> — {{ alert.description }}
                    {% if alert.evidence %}
                    <br><small style="color: var(--muted);">
                        {% set paths = [] %}
                        {% for e in alert.evidence %}
                            {% if e is string and ('\\' in e or '/' in e) %}{% if paths.append(e) %}{% endif %}{% endif %}
                        {% endfor %}
                        {% if paths %}Artifact: <code>{{ paths[0] }}</code>{% else %}Artifact: <code>{{ alert.evidence | join('; ') }}</code>{% endif %}
                    </small>
                    {% endif %}
                </span>
            </li>
            {% endfor %}
        </ul>
        {% else %}
        <p class="empty-state">No alerts raised during this investigation.</p>
        {% endif %}
    </div>

    <div class="card" id="sec-devices">
        <h3>Scanned Devices &amp; Volumes</h3>
        {% if drives %}
        <table class="report-table dev-table">
            <thead>
                <tr>
                    <th>Volume</th>
                    <th>Label</th>
                    <th>Filesystem</th>
                    <th class="size-nowrap">Total Size</th>
                    <th class="size-nowrap">Free Space</th>
                    <th>Type</th>
                </tr>
            </thead>
            <tbody>
                {% for drv in drives %}
                <tr>
                    <td><strong>{{ drv.drive_letter }}</strong></td>
                    <td>{{ drv.label or 'System Volume' }}</td>
                    <td><code>{{ drv.filesystem or 'NTFS' }}</code></td>
                    <td>{{ (drv.total_size / (1024**3)) | round(2) }} GB</td>
                    <td>{{ (drv.free_space / (1024**3)) | round(2) }} GB</td>
                    <td>
                        {% if drv.is_removable %}
                        <span class="badge badge-warn">USB Removable</span>
                        {% else %}
                        <span class="badge badge-ok">Fixed</span>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p class="empty-state">No volume data recorded.</p>
        {% endif %}
    </div>

    <div class="card">
        <h3>Investigation Profile &amp; Module Execution</h3>
        <p class="section-desc">
            Profile: <strong>{{ investigation.profile_name or 'full' | upper }}</strong>
            {% if investigation.profile_name %}
                — the modules below reflect what the selected profile actually ran during this scan.
            {% endif %}
        </p>
        {% if investigation.module_results %}
        <table class="report-table">
            <thead>
                <tr>
                    <th>Module</th>
                    <th>Status</th>
                    <th>Events</th>
                    <th>Alerts</th>
                    <th>Detail</th>
                </tr>
            </thead>
            <tbody>
                {% for m in investigation.module_results %}
                <tr>
                    <td><strong>{{ m.label }}</strong></td>
                    <td>
                        {% if m.status == 'ran' %}
                        <span class="badge badge-ok">Ran</span>
                        {% elif m.status == 'failed' %}
                        <span class="badge badge-danger">Failed</span>
                        {% else %}
                        <span class="badge badge-warn">Disabled / Skipped</span>
                        {% endif %}
                    </td>
                    <td>{{ m.events }}</td>
                    <td>{{ m.alerts }}</td>
                    <td style="color: var(--muted);">
                        {% if m.status == 'failed' %}<code>{{ m.detail }}</code>
                        {% else %}{{ m.detail or '—' }}{% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p class="empty-state">No module execution log recorded for this investigation.</p>
        {% endif %}
    </div>
</div>

<!-- ================= DATA MOVEMENT ================= -->
{% if sections.data_movement %}
<div id="tab-movement" class="panel">
    <h2 class="section-title">Data Movement</h2>
    <p class="section-desc">Files transferred between devices and files deleted during the investigation window.</p>

    {% if sections.transfers %}
    <div class="card">
        <h3>Data Flow Between Devices</h3>
        <div id="dataFlowChart"></div>
        {% if not movements and not deletions %}
        <p class="empty-state">No cross-device file movement was detected. This happens when the same file (by SHA-256 hash) is not found on more than one scanned device — e.g. no USB drive with matching files was attached during the scan.</p>
        {% endif %}
    </div>
    {% endif %}

    {% if sections.transfers %}
    <div class="card" id="sec-transfers">
        <h3>File Transfers</h3>
        {% if movements %}
        <table class="report-table">
            <thead>
                <tr>
                    <th>File</th>
                    <th>SHA-256</th>
                    <th>Source</th>
                    <th>Destination</th>
                    <th class="size-nowrap">When</th>
                </tr>
            </thead>
            <tbody>
                {% for m in movements %}
                <tr>
                    <td>
                        <strong>{{ m.file_name }}</strong>
                        {% if m.source_path %}<br><small style="color: var(--muted);">{{ m.source_path }}</small>{% endif %}
                    </td>
                    <td><code>{{ m.hash or '—' }}</code></td>
                    <td>{{ m.source }}</td>
                    <td>{{ m.target }}</td>
                    <td class="size-nowrap">{{ m.timestamp }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p class="empty-state">No file transfers detected. Transfers are only reported when the same file hash appears on two different devices (e.g. PC and a USB drive that was attached during the scan).</p>
        {% endif %}
    </div>
    {% endif %}

    {% if sections.deletions %}
    <div class="card" id="sec-deletions">
        <h3>Deleted Files &amp; Recovery</h3>
        {% if deletions %}
        <table class="report-table">
            <thead>
                <tr>
                    <th>File</th>
                    <th>Source Device / Path</th>
                    <th class="size-nowrap">Deleted / Modified</th>
                </tr>
            </thead>
            <tbody>
                {% for d in deletions %}
                <tr>
                    <td>
                        <strong>{{ d.file_name }}</strong>
                        {% if d.source_path %}<br><small style="color: var(--muted);">{{ d.source_path }}</small>{% endif %}
                    </td>
                    <td>{{ d.source }}</td>
                    <td class="size-nowrap">{{ d.timestamp }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% elif deleted_files %}
        <table class="report-table">
            <thead>
                <tr>
                    <th>File Name</th>
                    <th>Path</th>
                    <th class="size-nowrap">Size</th>
                    <th class="size-nowrap">Modified</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                {% for f in deleted_files[:300] %}
                <tr>
                    <td><strong>{{ f.file_name }}</strong></td>
                    <td><code>{{ f.file_path }}</code></td>
                    <td class="size-nowrap">{{ f.size }} bytes</td>
                    <td class="size-nowrap">{{ f.modified }}</td>
                    <td><span class="badge badge-ok">{{ f.recovery_status }}</span></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p class="empty-state">No deletions detected.</p>
        {% endif %}
        <div class="note-box">
            <strong>Limitation note:</strong> a file removed with <em>Shift+Delete</em> (or emptied from the
            Recycle Bin) bypasses the Recycle Bin entirely -- no <code>$I</code> metadata entry is ever created --
            so it is invisible to Recycle Bin parsing. Such deletions can only be recovered with raw-disk
            scanning (SleuthKit <code>fls</code>, requires administrator rights) or the NTFS USN journal.
        </div>
    </div>
    {% endif %}
</div>
{% endif %}

<!-- ================= TIMELINE ================= -->
<div id="tab-timeline" class="panel">
    <h2 class="section-title">Timeline &amp; Activity</h2>
    <p class="section-desc">Event distribution, 24x7 activity, and the full chronological event list.</p>

    <div class="chart-grid">
        <div class="card" id="sec-timeline">
            <h3>Event Timeline</h3>
            <div id="timelineChart"></div>
        </div>
        <div class="card">
            <h3>24x7 Activity Heatmap</h3>
            <div id="heatmapChart"></div>
        </div>
    </div>

    <div class="card">
        <h3>Event Log</h3>
        <p class="section-desc">Every collected event in chronological order.</p>
        {{ events_table(timeline_rows) }}
    </div>
</div>

<!-- ================= ALERTS ================= -->
<div id="tab-alerts" class="panel">
    <h2 class="section-title">Security Alerts</h2>
    <p class="section-desc">Anomalies and exfiltration indicators detected by the analysis engine.</p>
    <div class="card" id="sec-alerts">
        {% if investigation.alerts %}
        {{ alerts_table_html | safe }}
        {% else %}
        <p class="empty-state">No alerts raised during this investigation.</p>
        {% endif %}
    </div>
</div>

<!-- ================= EVIDENCE ================= -->
<div id="tab-evidence" class="panel">
    <h2 class="section-title">Evidence &amp; Chain of Custody</h2>
    <p class="section-desc">Case identification and the audit log of every tool action taken.</p>

    <div class="card">
        <h3>Case Identification</h3>
        <table class="report-table">
            <tbody>
                <tr><td style="width: 200px;">Case Reference</td><td><strong>{{ investigation.case_name }}</strong> (<code>{{ investigation.case_id }}</code>)</td></tr>
                <tr><td>Lead Investigator</td><td>{{ investigation.investigator or 'Ahmad Forensics' }}</td></tr>
                <tr><td>Report Generated</td><td>{{ generated_at }}</td></tr>
                <tr><td>Scanned Targets</td><td>{% for d in drives %}{{ d.drive_letter }} ({{ d.label or 'Volume' }}, {{ d.filesystem }}){% if not loop.last %}; {% endif %}{% else %}—{% endfor %}</td></tr>
            </tbody>
        </table>
    </div>

    <div class="card">
        <h3>Chain of Custody Audit Log</h3>
        {% if investigation.chain_of_custody %}
        <div class="custody-log">
            {% for entry in investigation.chain_of_custody %}
            <div>[{{ entry.timestamp }}] <strong>{{ entry.action }}</strong> — Target: {{ entry.target }} | Result: {{ entry.result }} (Tool: {{ entry.tool_name }})</div>
            {% endfor %}
        </div>
        {% else %}
        <p class="empty-state">[{{ generated_at }}] Case initialized by {{ investigation.investigator or 'Ahmad Forensics' }}. No additional custody entries recorded.</p>
        {% endif %}
    </div>

    <div class="card">
        <h3>Evidence Package</h3>
        <p style="font-size: 13px; color: var(--muted);">
            The full dataset (events, alerts, file records, correlations) is exported alongside this report
            as JSON and CSV, and packaged into a tamper-evident ZIP with SHA-256 integrity verification
            (see <code>exports/</code> and the chain-of-custody JSON in the case output directory).
        </p>
    </div>
</div>

{% endblock %}

{% block charts_js %}
['#filetypeChart', {{ filetype_chart_json | safe }}],
{% if sections.deletion_chart %}['#deletionChart', {{ deletion_chart_json | safe }}],{% endif %}
['#timelineChart', {{ timeline_chart_json | safe }}],
['#heatmapChart', {{ heatmap_chart_json | safe }}],
{% if sections.transfers %}['#dataFlowChart', {{ data_flow_chart_json | safe }}],{% endif %}
{% endblock %}
